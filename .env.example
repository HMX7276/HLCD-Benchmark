# Example settings only; not the historical manuscript run configuration.
# Copy to .env and fill locally. Never commit credentials or real patient data.
LLM_PROVIDER=auto
LLM_THINKING=auto
BASE_PROVIDER=openai
BASE_URL=http://127.0.0.1:8000/v1
BASE_MODEL=
BASE_KEY=
LLM_TEMPERATURE=0
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DB_MIMICIV=mimiciv
PG_DB_MIMICNOTE=mimicnote
# Keep the work directory outside this public repository.
HLCD_WORK=~/hlcd_work
COHORT_SIZE=2000
COHORT_SEED=42
MIN_LOS_DAYS=4
TIMELINE_VERSION=mimic_exact_time_v2
SPLIT_RATIO=5:1:3
SPLITS_SEED=42
B3_X_VALUES=1,2,3
B3_NEW_EXAM_LABS=5
TRAPS_N_PER_TYPE=5
TRAPS_SEED=13
EVAL_SEED=7
LLM_MAX_TOKENS=2000
LLM_RETRIES=3
LLM_TIMEOUT=600
LLM_MAX_TOKEN_BUDGET=16000
LLM_CONCURRENCY=1
RENDER_MAX_ABNORMAL_LABS=20
E2E_ANCHORED_MIN=0.95
